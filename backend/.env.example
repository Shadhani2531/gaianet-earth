# GaiaNet Earth — backend environment variables
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real keys.

# --- WAQI (World Air Quality Index) ---
# Used by: services/mock_data.py (generate_environment_data)
# Powers: /environment, /prediction (real-time AQI, temperature, PM2.5)
# Free token: https://aqicn.org/data-platform/token/
# Falls back to WAQI's shared "demo" token if unset (rate-limited, not
# reliable for regular use).
WAQI_TOKEN=

# --- OpenAQ v3 ---
# Used by: services/openaq_client.py
# Powers: /stations, /country-boundaries, /shi-global (Tab 6 composite SHI)
# v1/v2 were retired Jan 31, 2025 (HTTP 410) — v3 requires a free key.
# Get one at: https://explore.openaq.org
# Without this key, /shi-global returns status: "missing_api_key" and an
# empty country list rather than fabricating data.
OPENAQ_API_KEY=

# --- OpenWeatherMap ---
# Used by: services/weather.py
# Powers: /api/weather (Atmospheric Synchronization Engine — rain/snow/clouds)
# Free key: https://openweathermap.org/api
# Without this key, the endpoint returns a clearly-labeled deterministic
# mock (status: "mock") instead of live data — the app still runs.
OPENWEATHERMAP_API_KEY=

# --- Cesium Ion ---
# Used by: main.py (/api/config), served to the frontend at runtime
# Powers: base imagery + the Ion geocoder used by globe search
# Get a free token at: https://ion.cesium.com/tokens
# IMPORTANT: an earlier version of this project had a real token
# hardcoded directly in js/config.js and committed to git — that token
# should be treated as compromised (rotate it in the Ion dashboard) even
# after this fix. Once you have a new one, also restrict it to your
# actual domain(s) in the Ion dashboard, since Cesium Ion tokens are used
# client-side and this endpoint doesn't make that any more "secret" —
# it only keeps it out of source control.
# Without this key, the globe still loads using Cesium's own default
# (non-Ion) imagery — search via Ion just won't work (Nominatim fallback
# still will).
CESIUM_ION_TOKEN=

# --- CORS ---
# Used by: main.py
# Comma-separated list of allowed origins, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:8000,https://your-deployed-domain.com
# Leave blank to use the safe local-dev defaults (localhost:8000, localhost:5500).
# Set to "*" only if you specifically need to allow requests from anywhere.
CORS_ALLOWED_ORIGINS=
