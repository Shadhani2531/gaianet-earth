+# --- Available-dates lookup --------------------------------------------------
+# key: "lat,lon" (rounded) -> {"dates": [(calendar_date: datetime, modis_date: str), ...], "fetched_at": datetime}
+_dates_cache: Dict[str, Any] = {}
