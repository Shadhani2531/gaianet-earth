+# Historical years never change once a real MOD13Q1 composite is published
+# for them — only the "current/latest available year" entry could ever get
+# a newer composite later. 30 days is generous and safe either way: it
+# means repeated clicks on the same location don't re-hit ORNL DAAC for
+# weeks, and even the "latest year" entry only goes stale for at most a
+# month, well inside one 16-day compositing cycle's worth of slack.
+_history_cache: Dict[str, Any] = {}
+_HISTORY_CACHE_HOURS = 24 * 30
+
+# Fixed reference years for the Vegetation History chart. 2001 is the
+# earliest included since MOD13Q1 (Terra) coverage only begins Feb 2000 —
+# an earlier year like 1990 would have zero real MODIS data to show,
+# which is why it's deliberately excluded rather than left to silently
+# return "unavailable" for every location.
+_HISTORY_REFERENCE_YEARS = [2001, 2005, 2010, 2015, 2020]
+
+
+def get_ndvi_history(lat: float, lon: float) -> Dict[str, Any]:
+    """
+    Real historical NDVI at (lat, lon) for _HISTORY_REFERENCE_YEARS plus
+    whichever year the current "latest available" composite falls in, all
+    matched to the SAME approximate day-of-year (via
+    _nearest_available_modis_date) so values are seasonally comparable
+    across years rather than accidentally comparing, say, a dry-season
+    reading to a monsoon one. Every value is either a real MOD13Q1
+    composite (via the same _fetch_subset_ndvi_value the live single-
+    location lookup uses) or explicitly marked "unavailable" — never
+    fabricated, estimated, or interpolated. Cached per location; see
+    _HISTORY_CACHE_HOURS.
+
+    This does NOT touch the global 504-point vegetation grid or increase
+    its resolution — it only runs for the one location a user clicks on,
+    and reuses the /dates list that a prior get_ndvi_at_location() call
+    for the same point will likely have already cached.
+    """
+    cache_key = f"{round(lat, 2)},{round(lon, 2)}"
+    now = datetime.now(timezone.utc)
+    cached = _history_cache.get(cache_key)
+    if cached and (now - cached["fetched_at"]).total_seconds() < _HISTORY_CACHE_HOURS * 3600:
+        return cached["result"]
+
+    dates_list = _get_available_dates(lat, lon)
+    if not dates_list:
+        result = {
+            "lat": lat, "lon": lon, "years": [],
+            "error": "Could not retrieve MODIS composite dates for this location.",
+        }
+        _history_cache[cache_key] = {"result": result, "fetched_at": now}
+        return result
+
+    # Anchor "same approximate period" on whichever real composite is
+    # currently the latest-available for this point — i.e. the exact same
+    # period the live Insight-card NDVI value is already using — rather
+    # than an arbitrary hardcoded month.
+    now_candidates = sorted([(cd, md) for (cd, md) in dates_list if cd <= now], key=lambda c: c[0])
+    if not now_candidates:
+        result = {
+            "lat": lat, "lon": lon, "years": [],
+            "error": "No published MODIS composite available up to the present for this location.",
+        }
+        _history_cache[cache_key] = {"result": result, "fetched_at": now}
+        return result
+
+    latest_cal_date, _ = now_candidates[-1]
+    ref_month, ref_day, latest_year = latest_cal_date.month, latest_cal_date.day, latest_cal_date.year
+
+    target_years = sorted(set(_HISTORY_REFERENCE_YEARS + [latest_year]))
+
+    def fetch_year(year: int) -> Dict[str, Any]:
+        try:
+            target_dt = datetime(year, ref_month, ref_day, tzinfo=timezone.utc)
+        except ValueError:
+            # e.g. reference day is Feb 29 and `year` isn't a leap year
+            target_dt = datetime(year, ref_month, 28, tzinfo=timezone.utc)
+
+        match = _nearest_available_modis_date(lat, lon, target_dt)
+        if match is None:
+            return {"year": year, "ndvi": None, "modis_date": None, "calendar_date": None, "data_source": "unavailable"}
+
+        cal_date, modis_date = match
+        ndvi_value = _fetch_subset_ndvi_value(lat, lon, modis_date)
+        if ndvi_value is None:
+            return {"year": year, "ndvi": None, "modis_date": modis_date,
+                     "calendar_date": cal_date.date().isoformat(), "data_source": "unavailable"}
+
+        return {"year": year, "ndvi": ndvi_value, "modis_date": modis_date,
+                 "calendar_date": cal_date.date().isoformat(), "data_source": "real_modis"}
+
+    # A handful of years (<=6), run concurrently so the chart doesn't take
+    # 15-20+ seconds to render if fetched one at a time — this is nowhere
+    # near the scale of the 504-point grid's worker pool.
+    with ThreadPoolExecutor(max_workers=6) as executor:
+        years_out = list(executor.map(fetch_year, target_years))
+
+    result = {
+        "lat": lat,
+        "lon": lon,
+        "reference_period": f"{ref_month:02d}-{ref_day:02d}",
+        "years": years_out,
+    }
+    _history_cache[cache_key] = {"result": result, "fetched_at": now}
+    return result
+
